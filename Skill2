        "from fastapi import FastAPI, UploadFile, File\n",
        "from fastapi.testclient import TestClient\n",
        "import onnxruntime as ort\n",
        "import numpy as np\n",
        "from PIL import Image\n",
        "import io\n",
        "\n",
        "app = FastAPI()\n",
        "\n",
        "session = ort.InferenceSession(\"vision_model.onnx\")\n",
        "\n",
        "@app.get(\"/\")\n",
        "def home():\n",
        "    return {\"message\": \"VisionPort API Running\"}\n",
        "\n",
        "@app.post(\"/predict\")\n",
        "async def predict(file: UploadFile = File(...)):\n",
        "\n",
        "    image = Image.open(\n",
        "        io.BytesIO(await file.read())\n",
        "    ).convert(\"L\")\n",
        "\n",
        "    image = image.resize((28, 28))\n",
        "\n",
        "    data = np.array(image).astype(np.float32) / 255.0\n",
        "    data = data.reshape(1, 1, 28, 28)\n",
        "\n",
        "    result = session.run(\n",
        "        [\"output\"],\n",
        "        {\"input\": data}\n",
        "    )\n",
        "\n",
        "    digit = int(np.argmax(result[0]))\n",
        "\n",
        "    return {\"prediction\": digit}\n",
        "\n",
        "\n",
        "client = TestClient(app)\n",
        "\n",
        "response = client.get(\"/\")\n",
        "\n",
        "print(\"API Status:\", response.status_code)\n",
        "print(\"API Response:\", response.json())\n",
        "\n",
        "image, label = small_data[0]\n",
        "\n",
        "buffer = io.BytesIO()\n",
        "Image.fromarray(\n",
        "    (image.squeeze().numpy() * 255).astype(np.uint8)\n",
        ").save(buffer, format=\"PNG\")\n",
        "\n",
        "response = client.post(\n",
        "    \"/predict\",\n",
        "    files={\"file\": (\"test.png\", buffer.getvalue(), \"image/png\")}\n",
        ")\n",
        "\n",
        "print(\"Prediction Response:\", response.json())"
      ],
